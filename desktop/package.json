{
  "name": "haushaltsbuch",
  "productName": "Finanz MAMI",
  "version": "1.0.0",
  "description": "Finanz MAMI für Windows",
  "author": "Sascha",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke --no-sandbox",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.sascha.haushaltsbuch",
    "productName": "Finanz MAMI",
    "files": ["main.js", "preload.js", "app.html", "icon.png", "native.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Finanz MAMI",
      "artifactName": "Haushaltsbuch-Setup.exe"
    }
  }
}
